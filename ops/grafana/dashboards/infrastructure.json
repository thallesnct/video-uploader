{
  "uid": "infrastructure",
  "title": "Infrastructure",
  "tags": ["video-pipeline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "About this dashboard",
      "type": "text",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Container CPU/memory needs cAdvisor, which **is not part of this dev compose stack** — adding it is a new dependency (AGENTS.md non-negotiable #9), not something to bolt on mid-phase without that line of justification. What's below is what's actually available today: whether Prometheus can reach each scrape target at all, and the Kafka broker count kafka-exporter reports."
      }
    },
    {
      "id": 2,
      "title": "Scrape target health (1 = up)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Kafka brokers",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kafka_brokers"
        }
      ]
    },
    {
      "id": 4,
      "title": "Under-replicated partitions",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(kafka_topic_partition_under_replicated_partition)"
        }
      ]
    }
  ]
}
