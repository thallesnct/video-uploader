{
  "uid": "pipeline-overview",
  "title": "Pipeline Overview",
  "tags": ["video-pipeline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Messages handled (rate, by stage/outcome)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (stage, outcome) (rate(stage_messages_total[5m]))",
          "legendFormat": "{{stage}} / {{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Stage duration (all stages combined)",
      "description": "p50/p95/p99 across every stage — the closest thing to \"how long does a stage take\" ADR-0010's \"end-to-end latency\" panel means without a dedicated upload-to-complete metric. See the Stage Detail dashboard for per-stage breakdowns.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(stage_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stage_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(stage_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Messages in flight (by stage)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "stage_in_flight",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "SSE connections active",
      "description": "sse_connections_active is a plain (unlabeled) Gauge in a module shared by every service (obs.py) — every worker process registers it too, always stuck at 0 since only the API route ever touches it. job=\"api\" filters to the one series that means anything; sum() collapses it to a single number even once more than one API replica exists.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(sse_connections_active{job=\"api\"})"
        }
      ]
    }
  ]
}
