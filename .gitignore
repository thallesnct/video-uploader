.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo

# Local env & secrets — never commit real values; .env.example is the template
.env
.env.local
*.pem
*.key
# One deliberate exception: devauth's dev-only mock-issuer signing key is a
# committed fixture, not a secret (its own filename says so, and
# infra/security_verify.py's Trivy allow-list already documents the same
# reasoning) — never real credentials, never used for anything but minting
# local test tokens. The blanket *.pem rule above was silently excluding it
# from every `git add`, so a fresh clone (a real CI run) never had it at
# all and devauth's own eager `KEY_PATH.read_bytes()` at import time raised
# FileNotFoundError — this file existed only on the machine that generated
# it once, never in git.
!backend/services/devauth/dev-only-insecure-signing-key.pem

# Test media & scratch output. *.ts alone would also match every TypeScript
# source file in frontend/, so HLS segments are scoped to where ffmpeg
# actually writes them (tmp/, already ignored) rather than matched globally.
tmp/
*.mp4
*.m3u8
!tests/fixtures/**

# Local infra state
.data/

# uv cache when tests run in a container
.uv-cache/

# Host venv for integration tests (uv is not installed on this machine)
.venv-host/

# Generated fresh each `make kafka-prod-verify` run by infra/gen_kafka_certs.sh —
# a rehearsal-only keystore/truststore with a hardcoded password, never real secrets.
infra/kafka-certs/
