# Copy to .env and adjust. Never commit .env (see .gitignore).
# Every variable the stack reads is listed here — ADR-0015 (fail fast on missing config).

# ---- Kafka -----------------------------------------------------------------
# In-network clients use kafka:9092; host tools use localhost:29092 (ADR-0002).
# Services running in compose override this with kafka:9092; the host default
# is the external listener so tests and CLI tools work without extra config.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_BOOTSTRAP_INTERNAL=kafka:9092
KAFKA_BOOTSTRAP_EXTERNAL=localhost:29092
KAFKA_EXTERNAL_PORT=29092
# Fixed so the KRaft metadata log survives a volume wipe of a single node.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ---- Postgres --------------------------------------------------------------
POSTGRES_USER=videos
POSTGRES_PASSWORD=videos_dev_only
POSTGRES_DB=videos
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://videos:videos_dev_only@localhost:5432/videos

# ---- MinIO / S3 ------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=videos
S3_REGION=us-east-1
# Browsers PUT straight to the object store, so the bucket must allow the SPA
# origin — the classic first-run failure called out in ADR-0006.
# http://frontend:5173 is the e2e Playwright container's origin (make e2e),
# not a host-run one — it runs inside the compose network, so its page origin
# is the compose service name, not localhost.
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173,http://localhost:3000,http://frontend:5173

# ---- Identity (ADR-0016) ----------------------------------------------------
# Dev/CI/load-test issuer. Swap these three for a real provider in production;
# no application code changes.
OIDC_ISSUER=http://devauth:8080
OIDC_JWKS_URL=http://devauth:8080/jwks.json
OIDC_AUDIENCE=video-pipeline
DEVAUTH_PORT=8080
API_PORT=8000
FRONTEND_PORT=5173

# ---- Quotas (ADR-0016) ------------------------------------------------------
# What stops one tenant filling the transcode partitions. Phase 14 measures these.
QUOTA_MAX_UPLOAD_BYTES=5368709120
QUOTA_MAX_VIDEOS_IN_FLIGHT=10

# ---- Notify (Phase 11) -------------------------------------------------------
# webhook-sink is the dev/test stand-in for the real external system this
# would target in production — see docker-compose.yml.
NOTIFY_WEBHOOK_URL=http://webhook-sink:9100/webhook
NOTIFY_WEBHOOK_TIMEOUT_S=10.0

# ---- ffmpeg (Phase 12, ADR-0015 §1 containment) -----------------------------
# Caps ffmpeg's own thread count rather than letting it default to detecting
# the host's full core count — meaningless (and wasteful) inside a
# resource-limited container. Matches docker-compose.yml's own cpus: limit
# on worker-transcode/worker-thumbnail; keep them in sync if either changes.
FFMPEG_THREADS=2

# ---- App -------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development

# ---- Metrics multiprocess mode (Phase 12, ADR-0014's own noted gotcha) -----
# Unset by default — every service today runs one process (no worker's
# entrypoint forks, and the API compose block doesn't pass uvicorn
# --workers). Only relevant if the API is ever scaled to multiple worker
# processes in one container (Phase 13); set to a writable, empty directory
# in that case, or /metrics silently reflects only whichever worker process
# happened to answer the scrape rather than the aggregate.
# PROMETHEUS_MULTIPROC_DIR=
