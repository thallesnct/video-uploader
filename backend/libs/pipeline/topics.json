      "retries": true
    },
    {
      "name": "video.probed",
      "partitions": { "dev": 3, "prod": 6 },
      "retention_ms": 604800000,
      "produced_by": ["probe"],
      "consumed_by": ["thumbnail"],
      "retries": true
    },
    {
